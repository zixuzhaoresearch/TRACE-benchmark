              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "scenario"
                },
                "transform": {
                  "jsonPath": "primary_poi_type"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/scenario/travel_context",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "scenario"
                },
                "transform": {
                  "jsonPath": "travel_context"
                }
              }
            }
          ]
        },
        {
          "@type": "cr:Field",
          "@id": "default/referenced_pois",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/referenced_pois/business_id",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "referenced_pois"
                },
                "transform": {
                  "jsonPath": "business_id"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/referenced_pois/name",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
