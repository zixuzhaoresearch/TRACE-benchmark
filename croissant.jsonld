            },
            "extract": {
              "column": "city"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/scenario",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/scenario/persona_type",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "scenario"
                },
                "transform": {
