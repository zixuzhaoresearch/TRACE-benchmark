                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/scenario/persona_description",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
